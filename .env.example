DATABASE_URL=jdbc:postgresql://localhost:5432/sender
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=123456

JPA_SHOW_SQL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
PRESENCE_STORE=redis
PRESENCE_SESSION_TTL=90s
PRESENCE_SWEEP_MS=15000

JWT_SECRET=change-this-development-secret-to-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

FRONTEND_URL=http://localhost:3000

RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH_CREDENTIALS_MAX_HITS=10
RATE_LIMIT_AUTH_SESSION_MAX_HITS=30
RATE_LIMIT_PASSWORD_CHANGE_MAX_HITS=5
RATE_LIMIT_USER_SEARCH_MAX_HITS=30
RATE_LIMIT_PROFILE_UPDATE_MAX_HITS=10
RATE_LIMIT_AVATAR_UPLOAD_MAX_HITS=10
RATE_LIMIT_FRIENDSHIP_WRITE_MAX_HITS=20
RATE_LIMIT_CONVERSATION_WRITE_MAX_HITS=20
RATE_LIMIT_MESSAGE_SEND_MAX_HITS=60
RATE_LIMIT_MESSAGE_SEARCH_MAX_HITS=30
RATE_LIMIT_MESSAGE_PROGRESS_MAX_HITS=120
RATE_LIMIT_ATTACHMENT_UPLOAD_MAX_HITS=30
RATE_LIMIT_ATTACHMENT_DOWNLOAD_MAX_HITS=60
RATE_LIMIT_ATTACHMENT_LIST_MAX_HITS=30
RATE_LIMIT_TYPING_MAX_HITS=120
RATE_LIMIT_PRESENCE_HEARTBEAT_MAX_HITS=120

# Optional load-test (perf) overlays — do not use for normal local development.
# See perf/env.perf.example and perf/README.md. Example:
# JWT_ACCESS_TOKEN_MINUTES=120
# RATE_LIMIT_AUTH_CREDENTIALS_MAX_HITS=1000
# RATE_LIMIT_MESSAGE_SEND_MAX_HITS=600

MESSAGE_PROGRESS_FLUSH_MS=2000

S3_BUCKET=your-bucket-name
S3_REGION=ap-southeast-2
S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.ap-southeast-2.amazonaws.com
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=replace-with-iam-secret-access-key
S3_PRESIGN_SECONDS=300
AVATAR_MAX_BYTES=2097152
ATTACHMENT_MAX_BYTES=10485760
